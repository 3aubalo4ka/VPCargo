<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Админ-панель — VPCargo</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <main class="container wide">
    <header class="header-row">
      <h1>Админ-панель</h1>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="btn" type="submit">Выйти</button>
      </form>
    </header>

    <%- include('partials') %>

    <section>
      <h2>Создать клиента</h2>
      <form method="post" action="/admin/users" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="return_query" value="<%= returnQuery %>" />
        <input name="login" placeholder="login" required />
        <input name="phone" placeholder="+7XXXXXXXXXX" required />
        <input type="password" name="password" placeholder="пароль" required minlength="6" />
        <button class="btn" type="submit">Создать</button>
      </form>
    </section>

    <section>
      <h2>Добавить заказ</h2>
      <form method="post" action="/admin/orders" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="return_query" value="<%= returnQuery %>" />
        <input name="client" placeholder="логин или телефон" required />
        <input name="cargo_number" placeholder="номер груза" required />
        <button class="btn" type="submit">Добавить</button>
      </form>
    </section>

    <section>
      <h2>Импорт CSV / XLSX</h2>
      <form method="post" action="/upload" enctype="multipart/form-data" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="return_query" value="<%= returnQuery %>" />
        <input type="file" name="import_file" accept=".csv,.xlsx" required />
        <button class="btn" type="submit">Импорт</button>
      </form>
    </section>

    <section>
      <h2>Фильтр</h2>
      <form method="get" action="/admin" class="inline-form">
        <input name="search" value="<%= filters.search %>" placeholder="поиск" />
        <select name="status">
          <option value="">Все статусы</option>
          <% allowedStatuses.forEach((s) => { %>
            <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
        <select name="payment_status">
          <option value="">Все оплаты</option>
          <% allowedPayments.forEach((p) => { %>
            <option value="<%= p %>" <%= filters.payment_status === p ? 'selected' : '' %>><%= p %></option>
          <% }) %>
        </select>
        <select name="per_page">
          <% [25, 50, 100].forEach((pp) => { %>
            <option value="<%= pp %>" <%= pp === perPage ? 'selected' : '' %>><%= pp %>/стр</option>
          <% }) %>
        </select>
        <button class="btn" type="submit">Применить</button>
      </form>
    </section>

    <section>
      <h2>Заказы</h2>
      <table>
        <thead>
          <tr><th>Номер</th><th>Клиент</th><th>Телефон</th><th>Управление</th></tr>
        </thead>
        <tbody>
          <% orders.forEach((o) => { %>
            <tr>
              <td><%= o.cargo_number %></td>
              <td><%= o.login %></td>
              <td><%= o.phone %></td>
              <td>
                <form method="post" action="/admin/orders/<%= o.id %>/update" class="inline-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="return_query" value="<%= returnQuery %>" />
                  <select name="status">
                    <% allowedStatuses.forEach((s) => { %>
                      <option value="<%= s %>" <%= s === o.status ? 'selected' : '' %>><%= s %></option>
                    <% }) %>
                  </select>
                  <select name="payment_status">
                    <% allowedPayments.forEach((p) => { %>
                      <option value="<%= p %>" <%= p === o.payment_status ? 'selected' : '' %>><%= p %></option>
                    <% }) %>
                  </select>
                  <input type="date" name="date_sent" value="<%= o.date_sent ? new Date(o.date_sent).toISOString().slice(0, 10) : '' %>" />
                  <input type="number" step="0.01" min="0" name="cost" value="<%= Number(o.cost).toFixed(2) %>" />
                  <button class="btn" type="submit">Сохранить</button>
                </form>

                <form method="post" action="/admin/orders/<%= o.id %>/delete" class="inline-form" onsubmit="return confirm('Удалить заказ?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                  <input type="hidden" name="return_query" value="<%= returnQuery %>" />
                  <button class="btn danger" type="submit">Удалить</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <div class="pagination">
        <a href="/admin?<%= new URLSearchParams({ ...filters, per_page: String(perPage), page: String(Math.max(1, page - 1)) }).toString() %>">←</a>
        <span>Стр. <%= page %> / <%= totalPages %></span>
        <a href="/admin?<%= new URLSearchParams({ ...filters, per_page: String(perPage), page: String(Math.min(totalPages, page + 1)) }).toString() %>">→</a>
      </div>
    </section>
  </main>
</body>
</html>
